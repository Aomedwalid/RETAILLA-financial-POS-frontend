          <h4 className="text-[10px] font-bold uppercase tracking-wider text-outline mb-4">Dashboard</h4>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            <StatBox label="Total Spent" value={fmt(overview.total_spent)} color="text-primary" />
            <StatBox label="Outstanding" value={fmt(overview.total_outstanding)} color="text-error" />
            <StatBox label="Total Bills" value={String(overview.total_bills)} color="text-on-surface" />
            <StatBox label="Avg Bill" value={fmt(overview.average_bill_amount)} color="text-secondary" />
          </div>
          {overview.recent_bills.length > 0 && (
            <div className="mt-4 pt-4 border-t border-outline-variant/50">
              <p className="text-[10px] font-bold uppercase tracking-wider text-outline mb-2">Recent Bills</p>
              <div className="space-y-1.5">
                {overview.recent_bills.map((b) => (
                  <div key={b.id} className="flex items-center justify-between text-xs">
                    <span className="text-on-surface-variant">{b.bill_reference || b.id.slice(0, 8)}</span>
                    <span className="font-data-table text-on-surface">{fmt(b.amount)}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ) : null}

      {outstandingBills.length > 0 && (
        <div className="bg-surface-container-low border border-error/20 rounded-xl p-5">
          <div className="flex items-center gap-2 mb-4">
            <span className="material-symbols-outlined text-sm text-error">priority_high</span>
            <h4 className="text-[10px] font-bold uppercase tracking-wider text-error">Outstanding Bills ({outstandingBills.length})</h4>
          </div>
          <div className="space-y-2">
            {outstandingBills.map((b) => (
              <div key={b.id} className="flex items-center justify-between bg-surface-container-highest rounded-lg px-4 py-2.5 text-xs">
                <div className="flex items-center gap-3">
                  <span className="text-on-surface-variant">{b.bill_reference || b.id.slice(0, 8)}</span>
                  {b.due_date && <span className="text-outline">Due {formatDate(b.due_date)}</span>}
                </div>
                <div className="flex items-center gap-3">
                  <span className="text-outline">{fmt(b.amount_remaining)} remaining</span>
                  <span className="font-data-table text-on-surface font-bold">{fmt(b.amount)}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

function InfoRow({ label, value, mono }: { label: string; value: string; mono?: boolean }) {
  return (
