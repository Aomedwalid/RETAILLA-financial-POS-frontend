<file path="components/PayBillModal.tsx">
import { useState } from "react";
import { vendorsApi } from "@/features/vendors/api";
import type { BillResponse, PayBillRequest } from "@/features/vendors/types";
import { fmt } from "@/features/vendors/types";

interface PayBillModalProps {
  vendorId: string;
  bill: BillResponse;
  onDone: () => void;
}

export default function PayBillModal({ vendorId, bill, onDone }: PayBillModalProps) {
  const [open, setOpen] = useState(false);
  const remVal = parseFloat(bill.amount_remaining || "0");
  const [amount, setAmount] = useState(String(remVal));
  const [method, setMethod] = useState("DIGITAL");
  const [notes, setNotes] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState("");

  async function handleSubmit() {
    const amt = parseFloat(amount);
    if (!amt || amt <= 0) { setError("Amount must be greater than 0"); return; }
    if (amt > remVal) { setError(`Amount exceeds remaining balance of ${fmt(bill.amount_remaining)}`); return; }
    setError("");
    setSubmitting(true);
    try {
      const body: PayBillRequest = { amount: amt, payment_method: method };
      if (notes.trim()) body.notes = notes.trim();
      await vendorsApi.payBill(vendorId, bill.id, body);
      setOpen(false);
      onDone();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Payment failed");
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <>
      <button onClick={() => setOpen(true)} className="px-3 py-1 rounded-lg bg-primary/10 text-primary border border-primary/20 text-[10px] font-bold hover:bg-primary/20 transition-all">
        Pay {fmt(bill.amount_remaining)}
      </button>
      {open && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4" onClick={() => setOpen(false)}>
          <div className="absolute inset-0 bg-black/80 backdrop-blur-sm" />
          <div className="relative w-full max-w-sm bg-surface-container-high rounded-2xl border border-outline-variant shadow-2xl animate-scale-in" onClick={(e) => e.stopPropagation()}>
            <div className="px-6 py-4 border-b border-outline-variant flex items-center justify-between">
              <h3 className="font-headline-sm text-headline-sm text-on-surface">Pay Bill</h3>
              <button onClick={() => setOpen(false)} className="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant"><span className="material-symbols-outlined">close</span></button>
            </div>
            <div className="p-6 space-y-4">
              <div className="bg-surface-container-low rounded-xl p-3 flex items-center justify-between text-xs">
                <div>
                  <span className="text-on-surface-variant">{bill.bill_reference || `#${bill.id.slice(0, 8)}`}</span>
                  <p className="text-[10px] text-outline mt-0.5">{fmt(bill.amount_remaining)} remaining</p>
                </div>
                <span className="font-data-table text-on-surface">{fmt(bill.amount)}</span>
              </div>
              <Field label="Payment Amount">
                <div className="relative">
                  <span className="absolute left-3 top-1/2 -translate-y-1/2 text-outline text-sm">$</span>
                  <input type="number" step="0.01" min="0.01" max={remVal} value={amount} onChange={(e) => setAmount(e.target.value)} className="w-full h-10 pl-7 pr-3 rounded-lg border border-outline/30 bg-surface-container-high text-on-surface text-sm outline-none focus:border-primary font-data-table" />
                </div>
              </Field>
              <Field label="Payment Method">
                <select value={method} onChange={(e) => setMethod(e.target.value)} className="w-full h-10 px-3 rounded-lg border border-outline/30 bg-surface-container-high text-on-surface text-sm outline-none focus:border-primary">
                  <option value="CASH">Cash</option>
                  <option value="DIGITAL">Digital</option>
                  <option value="BANK_TRANSFER">Bank Transfer</option>
                </select>
              </Field>
              <Field label="Notes (optional)">
                <input value={notes} onChange={(e) => setNotes(e.target.value)} className="w-full h-10 px-3 rounded-lg border border-outline/30 bg-surface-container-high text-on-surface text-sm outline-none focus:border-primary" placeholder="Payment completed" />
              </Field>
              {error && <p className="text-sm text-error bg-error/10 px-3 py-2 rounded-lg">{error}</p>}
            </div>
            <div className="px-6 py-4 border-t border-outline-variant flex justify-end gap-3">
              <button onClick={() => setOpen(false)} disabled={submitting} className="px-4 py-2 rounded-lg border border-outline-variant text-sm text-on-surface-variant hover:bg-surface-variant/20">Cancel</button>
              <button onClick={handleSubmit} disabled={submitting} className="px-5 py-2 rounded-lg bg-error text-on-error text-sm font-bold flex items-center gap-2 disabled:opacity-50">
                {submitting && <span className="material-symbols-outlined text-sm animate-spin">progress_activity</span>}
                Pay {fmt(parseFloat(amount) || 0)}
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}

function Field({ label, children }: { label: string; children: React.ReactNode }) {
  return (
    <div>
      <label className="text-[10px] font-bold uppercase tracking-wider text-outline mb-1 block">{label}</label>
      {children}
    </div>
  );
}
</file>

<file path="components/ProgressBar.tsx">
interface ProgressBarProps {
  paid: string | number | null;
  total: string | number | null;
  status: string;
}

export default function ProgressBar({ paid, total, status }: ProgressBarProps) {
  const pPaid = paid == null ? 0 : (typeof paid === "string" ? parseFloat(paid) : paid);
  const pTotal = total == null ? 0 : (typeof total === "string" ? parseFloat(total) : total);
  const pct = pTotal > 0 ? Math.min(pPaid / pTotal, 1) : 0;
  const color = status === "PAID" ? "bg-secondary" : status === "OVERDUE" ? "bg-error" : pct > 0 ? "bg-[#d99c00]" : "bg-outline/30";
  return (
    <div className="flex items-center gap-2">
      <div className="flex-1 h-1.5 rounded-full bg-outline/10 overflow-hidden">
        <div className={`h-full rounded-full transition-all ${color}`} style={{ width: `${pct * 100}%` }} />
      </div>
      <span className="text-[10px] font-data-table text-outline min-w-[3rem] text-right">
        {Math.round(pct * 100)}%
      </span>
    </div>
  );
}
</file>

<file path="components/ReceiptIngestionModal.tsx">
"use client";

import { useState, useRef, useMemo, useCallback, useEffect } from "react";
import { vendorsApi } from "@/features/vendors/api";
import { fmt, ACCEPTED_MIME_TYPES, ACCEPTED_EXTENSIONS, MAX_FILE_SIZE } from "@/features/vendors/types";
import type {
  ReviewLineState,
  ReviewVariantState,
  ReceiptIngestionStep,
  ConfirmedReceiptLine,
} from "@/features/vendors/types";

interface ExistingPOLine {
  variant_id: string;
  quantity: number;
  unit_cost: string;
  product_name: string;
  attributes: Record<string, string>;
  price: string;
}

interface ReceiptIngestionModalProps {
  vendorId: string;
  vendorName: string;
  onClose: () => void;
  onDone: () => void;
  existingPO?: {
    lines: ExistingPOLine[];
    notes?: string | null;
  };
}

export default function ReceiptIngestionModal({ vendorId, vendorName, onClose, onDone, existingPO }: ReceiptIngestionModalProps) {
  const [step, setStep] = useState<ReceiptIngestionStep>(existingPO ? "review" : "upload");
  const [file, setFile] = useState<File | null>(null);
  const [filePreview, setFilePreview] = useState<string | null>(null);
  const [source, setSource] = useState<"image" | "excel" | null>(null);
  const [isDragOver, setIsDragOver] = useState(false);

  const [lines, setLines] = useState<ReviewLineState[]>([]);
  const [totalCost, setTotalCost] = useState("0.00");
  const [extractionNotes, setExtractionNotes] = useState<string | null>(null);
  const [newProductsCount, setNewProductsCount] = useState(0);

  const [billReference, setBillReference] = useState("");
  const [dueDate, setDueDate] = useState("");
  const [notes, setNotes] = useState("");

  const [processing, setProcessing] = useState(false);
  const [confirming, setConfirming] = useState(false);
  const [error, setError] = useState("");
  const [confirmResult, setConfirmResult] = useState<{ billAmount: string; newProducts: number } | null>(null);

  useEffect(() => {
    if (!existingPO) return;
    const seen = new Map<string, { name: string; variants: ExistingPOLine[] }>();
    for (const l of existingPO.lines) {
      const key = l.product_name;
      if (!seen.has(key)) {
        seen.set(key, { name: key, variants: [] });
      }
      seen.get(key)!.variants.push(l);
    }
    setLines(Array.from(seen.values()).map((g) => ({
      raw_name: "",
      product_name: g.name,
      is_variant_group: g.variants.length > 1 || Object.keys(g.variants[0]?.attributes || {}).length > 0,
      matched_product_id: null,
      is_new_product: false,
      variants: g.variants.map((v) => ({
        attributes: v.attributes,
        quantity: v.quantity,
        unit_cost: parseFloat(v.unit_cost),
        price: v.price || "",
      })),
      price: "",
      cost: "",
      description: "",
      category_id: "",
      low_stock_threshold: "",
      internal_notes: "",
    })));
    if (existingPO.notes) setNotes(existingPO.notes);
  }, [existingPO]);

  const fileInputRef = useRef<HTMLInputElement>(null);

  const liveTotal = useMemo(() => {
    return lines.reduce((sum, line) =>
      sum + line.variants.reduce((s, v) => s + v.quantity * v.unit_cost, 0), 0);
  }, [lines]);

  const allVariantsValid = useMemo(() => {
    if (lines.length === 0) return false;
    return lines.every((line) =>
      line.variants.length > 0 && line.variants.every((v) => {
        const c = v.unit_cost;
        const p = parseFloat(v.price);
        return c > 0 && !isNaN(p) && p > 0;
      })
    );
  }, [lines]);

  const liveNewProductCount = useMemo(() => {
    return lines.filter((l) => l.is_new_product).length;
  }, [lines]);

  function acceptFile(f: File): boolean {
    setError("");
    if (f.size > MAX_FILE_SIZE) {
      setError("File exceeds 10MB limit. Please choose a smaller file.");
      return false;
    }
    if (!ACCEPTED_MIME_TYPES.includes(f.type)) {
      setError(`Invalid file type. Accepted: ${ACCEPTED_EXTENSIONS}`);
      return false;
    }
    setFile(f);
    if (f.type.startsWith("image/")) {
      if (filePreview) URL.revokeObjectURL(filePreview);
      setFilePreview(URL.createObjectURL(f));
      setSource("image");
    } else {
      if (filePreview) URL.revokeObjectURL(filePreview);
      setFilePreview(null);
      setSource("excel");
    }
    return true;
  }

  function handleFileChange(e: React.ChangeEvent<HTMLInputElement>) {
    const f = e.target.files?.[0];
    if (f) acceptFile(f);
  }

  function handleDragOver(e: React.DragEvent) {
    e.preventDefault();
    e.stopPropagation();
    setIsDragOver(true);
  }

  function handleDragLeave(e: React.DragEvent) {
    e.preventDefault();
    e.stopPropagation();
    setIsDragOver(false);
  }

  function handleDrop(e: React.DragEvent) {
    e.preventDefault();
    e.stopPropagation();
    setIsDragOver(false);
    const f = e.dataTransfer.files?.[0];
    if (f) acceptFile(f);
  }

  const handleProcess = useCallback(async () => {
    if (!file) return;
    setProcessing(true);
    setError("");
    try {
      const result = await vendorsApi.processReceipt(vendorId, file);
      setLines(
        result.lines.map((l) => ({
          raw_name: l.raw_name,
          product_name: l.product_name,
          is_variant_group: l.is_variant_group,
          matched_product_id: l.matched_product_id,
          is_new_product: l.is_new_product,
          variants: l.variants.length > 0
            ? l.variants.map((v) => ({
                attributes: v.attributes,
                quantity: v.quantity ?? 1,
                unit_cost: v.unit_cost ?? 0,
                price: String(v.unit_cost || 0),
              }))
            : [{ attributes: {}, quantity: 1, unit_cost: 0, price: "0" }],
          price: String(l.price ?? l.variants[0]?.unit_cost ?? 0),
          cost: String(l.cost ?? l.variants[0]?.unit_cost ?? 0),
          description: "",
          category_id: "",
          low_stock_threshold: "",
          internal_notes: "",
        }))
      );
      setTotalCost(result.total_cost);
      setExtractionNotes(result.extraction_notes);
      setSource(result.source);
      setNewProductsCount(result.lines.filter((l) => l.is_new_product).length);
      setStep("review");
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Failed to process receipt";
      setError(msg);
    } finally {
      setProcessing(false);
    }
  }, [file, vendorId]);

  function updateLineProductName(index: number, value: string) {
    setLines((prev) =>
      prev.map((line, i) => (i === index ? { ...line, product_name: value } : line))
    );
  }

  function updateVariant(lineIndex: number, variantIndex: number, field: keyof ReviewVariantState, value: string | number | Record<string, string>) {
    setLines((prev) =>
      prev.map((line, i) =>
        i === lineIndex
          ? {
              ...line,
              variants: line.variants.map((v, vi) =>
                vi === variantIndex ? { ...v, [field]: value } : v
              ),
            }
          : line
      )
    );
  }

  const handleConfirm = useCallback(async () => {
    setConfirming(true);
    setError("");
    try {
      const result = await vendorsApi.confirmReceipt(vendorId, {
        lines: lines.map((l) => {
          const line: ConfirmedReceiptLine = {
            raw_name: l.raw_name,
            product_name: l.product_name,
            is_variant_group: l.is_variant_group,
            matched_product_id: l.matched_product_id,
            variants: l.variants.map((v) => ({
              attributes: v.attributes,
              quantity: v.quantity ?? 1,
              unit_cost: v.unit_cost ?? 0,
              price: parseFloat(v.price) || 0,
            })),
            price: parseFloat(l.price) || 0,
            cost: parseFloat(l.cost) || 0,
          };
          if (l.description.trim()) line.description = l.description.trim();
          if (l.category_id.trim()) line.category_id = l.category_id.trim();
          const threshold = parseInt(l.low_stock_threshold, 10);
          if (!isNaN(threshold) && threshold > 0) line.low_stock_threshold = threshold;
          if (l.internal_notes.trim()) line.internal_notes = l.internal_notes.trim();
          return line;
        }),
        bill_reference: billReference.trim() || null,
        due_date: dueDate ? new Date(dueDate).toISOString() : null,
        notes: notes.trim() || null,
      });
      setConfirmResult({
        billAmount: fmt(result.bill.amount),
        newProducts: result.new_products_created,
      });
      setStep("confirmed");
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Failed to confirm receipt";
      setError(`${msg}. If the error persists, check vendor bills for duplicates before retrying.`);
    } finally {
      setConfirming(false);
    }
  }, [vendorId, lines, billReference, dueDate, notes]);

  function resetAndClose() {
    if (filePreview) URL.revokeObjectURL(filePreview);
    onClose();
    onDone();
  }

  return (
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-4"
      onDragOver={(e) => e.preventDefault()}
      onDrop={(e) => e.preventDefault()}
    >
      <div className="absolute inset-0 bg-black/80 backdrop-blur-sm" />
      <div className={`relative bg-surface-container-high rounded-2xl border border-outline-variant shadow-2xl flex flex-col animate-scale-in ${
        step === "review" ? "w-full max-w-3xl max-h-[90vh]" : "w-full max-w-md"
      }`} onClick={(e) => e.stopPropagation()}>

        {/* ─── HEADER ─── */}
        <div className="shrink-0 px-6 py-4 border-b border-outline-variant flex items-center justify-between">
          <div>
            <h3 className="font-headline-sm text-headline-sm text-on-surface">
              {step === "upload" && "Upload Receipt"}
              {step === "review" && "Review Receipt Lines"}
              {step === "confirmed" && "Receipt Confirmed"}
            </h3>
            <p className="text-[11px] text-on-surface-variant mt-0.5">{vendorName}</p>
          </div>
          <button onClick={resetAndClose} disabled={processing || confirming} className="w-8 h-8 flex items-center justify-center rounded-full hover:bg-surface-variant text-on-surface-variant disabled:opacity-30">
            <span className="material-symbols-outlined">close</span>
          </button>
        </div>

        {/* ─── STEP: UPLOAD ─── */}
        {step === "upload" && (
          <div className="p-6 space-y-5">
            <div
              onClick={() => fileInputRef.current?.click()}
              onDragOver={handleDragOver}
              onDragLeave={handleDragLeave}
              onDrop={handleDrop}
              className={`border-2 border-dashed rounded-xl p-8 text-center cursor-pointer transition-colors ${
                isDragOver
                  ? "border-primary bg-primary/5"
                  : "border-outline/30 hover:border-primary/40"
              }`}
            >
              {filePreview ? (
                <img src={filePreview} alt="Receipt preview" className="max-h-48 mx-auto rounded-lg object-contain" />
              ) : file ? (
                <div className="flex flex-col items-center gap-2">
                  <span className="material-symbols-outlined text-[40px] text-primary">description</span>
                  <p className="text-sm text-on-surface font-medium">{file.name}</p>
                  <p className="text-[11px] text-outline">{(file.size / 1024 / 1024).toFixed(1)} MB</p>
                </div>
              ) : (
                <div className="flex flex-col items-center gap-2">
                  <span className="material-symbols-outlined text-[40px] text-outline">cloud_upload</span>
                  <p className="text-sm text-on-surface font-medium">Drop a receipt here or click to browse</p>
                  <p className="text-[11px] text-outline">Accepts {ACCEPTED_EXTENSIONS} (max 10MB)</p>
                </div>
              )}
              <input
                ref={fileInputRef}
                type="file"
                accept={ACCEPTED_EXTENSIONS}
                onChange={handleFileChange}
                className="hidden"
              />
            </div>

            {error && (
              <div className="flex items-start gap-2 p-3 rounded-lg bg-error/10 text-sm text-error">
                <span className="material-symbols-outlined text-sm shrink-0 mt-0.5">error</span>
                <span>{error}</span>
              </div>
            )}

            <div className="flex justify-end gap-3">
              <button onClick={onClose} disabled={processing} className="px-4 py-2 rounded-lg border border-outline-variant text-sm text-on-surface-variant hover:bg-surface-variant/20">Cancel</button>
              <button
                onClick={handleProcess}
                disabled={!file || processing}
                className="px-5 py-2 rounded-lg bg-primary text-on-primary text-sm font-bold flex items-center gap-2 disabled:opacity-50"
              >
                {processing ? (
                  <>
                    <span className="material-symbols-outlined text-sm animate-spin">progress_activity</span>
                    Reading your receipt...
                  </>
                ) : (
                  "Upload & Process"
                )}
              </button>
            </div>
          </div>
        )}

        {/* ─── STEP: REVIEW ─── */}
        {step === "review" && (
          <div className="flex-1 overflow-y-auto p-6 space-y-6">
            {extractionNotes && (
              <div className="flex items-start gap-2 p-3 rounded-lg bg-[#d99c00]/10 text-sm text-[#d99c00] border border-[#d99c00]/20">
                <span className="material-symbols-outlined text-sm shrink-0 mt-0.5">info</span>
                <span>AI note: {extractionNotes}</span>
              </div>
            )}

            {lines.map((line, li) => {
              const lineTotal = line.variants.reduce((s, v) => s + v.quantity * v.unit_cost, 0);
              return (
                <div key={li} className="bg-surface-container-low border border-outline-variant rounded-xl p-4 space-y-3">
                  <div className="flex items-center justify-between gap-3">
                    <div className="flex-1">
                      {existingPO ? (
                        <p className="text-sm text-on-surface font-semibold py-0.5">{line.product_name}</p>
                      ) : (
                        <input
                          value={line.product_name}
                          onChange={(e) => updateLineProductName(li, e.target.value)}
                          className="w-full bg-transparent border-b border-transparent hover:border-outline/30 focus:border-primary text-sm text-on-surface font-semibold outline-none py-0.5"
                        />
                      )}
                      {line.raw_name && <p className="text-[10px] text-outline mt-0.5">Raw: {line.raw_name}</p>}
                    </div>
                    <div className="shrink-0 flex items-center gap-2">
                      {line.is_new_product ? (
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-full border bg-[#d99c00]/10 text-[#d99c00] border-[#d99c00]/20">
                          New Product
                        </span>
                      ) : (
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-full border bg-secondary/10 text-secondary border-secondary/20">
                          Matched
                        </span>
                      )}
                      {line.is_variant_group && (
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-full border bg-primary/10 text-primary border-primary/20">
                          Variant Group
                        </span>
                      )}
                    </div>
                  </div>

                  {line.variants.length > 0 && (
                    <div className="overflow-x-auto">
                      <table className="w-full text-left border-collapse">
                        <thead>
                          <tr className="border-b border-outline-variant/50">
                            {line.is_variant_group && (
                              <th className="text-[10px] font-bold uppercase tracking-wider text-outline pb-2 pr-2">Attributes</th>
                            )}
                            <th className="text-[10px] font-bold uppercase tracking-wider text-outline pb-2 pr-2 w-[70px]">Qty</th>
                            <th className="text-[10px] font-bold uppercase tracking-wider text-outline pb-2 pr-2 w-[90px]">Cost</th>
                            <th className="text-[10px] font-bold uppercase tracking-wider text-outline pb-2 w-[120px]">Price</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-outline-variant/30">
                          {line.variants.map((v, vi) => {
                            const attrStr = Object.entries(v.attributes)
                              .map(([k, val]) => `${k}: ${val}`)
                              .join(", ");
                            const vTotal = v.quantity * v.unit_cost;
                            return (
                              <tr key={vi}>
                                {line.is_variant_group && (
                                  <td className="py-2 pr-2">
                                    <span className="text-[11px] text-on-surface-variant">{attrStr}</span>
                                  </td>
                                )}
                                <td className="py-2 pr-2">
                                  {existingPO ? (
                                    <span className="text-sm text-on-surface font-data-table py-0.5 block">{v.quantity}</span>
                                  ) : (
