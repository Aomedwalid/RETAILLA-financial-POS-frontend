                    />
                  </Field>
                  <Field label="Unit Cost">
                    <div className="relative">
                      <span className="absolute left-2 top-1/2 -translate-y-1/2 text-outline text-xs">$</span>
                      <input
                        type="number"
                        step="0.01"
                        min="0"
                        value={line.variants[0]?.unit_cost ?? 0}
                        onChange={(e) => updateVariant(line.id, line.variants[0]?.id ?? "", { unit_cost: parseFloat(e.target.value) || 0 })}
                        className="w-full h-9 pl-5 pr-3 rounded-lg border border-outline/30 bg-surface-container-high text-sm text-on-surface outline-none focus:border-primary font-data-table"
                      />
                    </div>
                  </Field>
                  <Field label="Price">
                    <div className="relative">
                      <span className="absolute left-2 top-1/2 -translate-y-1/2 text-outline text-xs">$</span>
                      <input
                        type="number"
                        step="0.01"
                        min="0"
                        value={line.variants[0]?.price ?? ""}
                        onChange={(e) => updateVariant(line.id, line.variants[0]?.id ?? "", { price: e.target.value })}
                        className="w-full h-9 pl-5 pr-3 rounded-lg border border-outline/30 bg-surface-container-high text-sm text-on-surface outline-none focus:border-primary font-data-table"
                        placeholder="0.00"
                      />
                    </div>
                  </Field>
                </div>
              )}
