<file path="components/dashboard/AnomaliesFeed.tsx">
"use client";

import useQuery from "@/lib/useQuery";
import { reportsApi } from "@/lib/api";

interface AnomalyItem {
  id: string;
  type: string;
  user: string;
  rate: number;
  avgRate: number;
  count: number;
  severity: string;
}

export default function AnomaliesFeed() {
  const { data, loading, error } = useQuery(
    () => Promise.all([
      reportsApi.refundAnomalies({}),
      reportsApi.discountAnomalies({}),
    ]),
    []
  );

  const [refunds, discounts] = Array.isArray(data) ? data : [[], []];

  const anomalies: AnomalyItem[] = [
    ...(Array.isArray(refunds) ? refunds.filter((a: { is_refund_anomaly: boolean }) => a.is_refund_anomaly).map((a: { user_id: string; user_email?: string; refund_rate: number | string; tenant_avg_refund_rate: number | string; refund_count: number }) => ({
      id: `refund-${a.user_id}`,
      type: "refund",
      user: a.user_email || a.user_id,
      rate: parseFloat(String(a.refund_rate)),
      avgRate: parseFloat(String(a.tenant_avg_refund_rate)),
      count: a.refund_count,
      severity: parseFloat(String(a.refund_rate)) > parseFloat(String(a.tenant_avg_refund_rate)) * 2 ? "high" : "medium",
    })) : []),
    ...(Array.isArray(discounts) ? discounts.filter((a: { is_discount_anomaly: boolean }) => a.is_discount_anomaly).map((a: { user_id: string; user_email?: string; discount_rate: number | string; tenant_avg_discount_rate: number | string; discount_usage_count: number }) => ({
      id: `discount-${a.user_id}`,
      type: "discount",
      user: a.user_email || a.user_id,
      rate: parseFloat(String(a.discount_rate)),
      avgRate: parseFloat(String(a.tenant_avg_discount_rate)),
      count: a.discount_usage_count,
      severity: parseFloat(String(a.discount_rate)) > parseFloat(String(a.tenant_avg_discount_rate)) * 2 ? "high" : "medium",
    })) : []),
  ].sort((a, b) => b.rate - a.rate);

  if (loading) {
    return (
      <div className="glass-card rounded-xl p-card-padding flex flex-col animate-pulse">
        <div className="flex items-center justify-between mb-6">
          <div className="h-3 w-28 rounded bg-surface-container-highest/60" />
          <div className="h-5 w-5 rounded bg-surface-container-highest/60" />
        </div>
        <div className="space-y-4 flex-1">
          {[1, 2, 3].map((i) => (
            <div key={i} className="p-3 rounded-lg bg-surface-container-low border border-outline-variant flex items-start gap-3">
              <div className="w-8 h-8 rounded bg-surface-container-highest/60" />
              <div className="flex-1 space-y-2">
                <div className="h-4 w-36 rounded bg-surface-container-highest/60" />
                <div className="h-3 w-48 rounded bg-surface-container-highest/60" />
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="glass-card rounded-xl p-card-padding">
        <p className="text-label-caps text-on-surface-variant uppercase">Anomalies Feed</p>
        <div className="flex flex-col items-center justify-center py-8 text-center">
          <p className="text-xs text-on-surface-variant">Failed to load anomalies</p>
        </div>
      </div>
    );
  }

  return (
    <div className="glass-card rounded-xl p-card-padding flex flex-col">
      <div className="flex items-center justify-between mb-6">
        <p className="text-label-caps text-on-surface-variant uppercase">Anomalies Feed</p>
        <span className="material-symbols-outlined text-outline text-[20px]">warning</span>
      </div>

      {anomalies.length === 0 ? (
        <div className="flex-1 flex flex-col items-center justify-center py-8 text-center">
          <span className="material-symbols-outlined text-[32px] text-secondary mb-2">check_circle</span>
          <p className="text-xs text-on-surface-variant">No anomalies detected</p>
        </div>
      ) : (
        <div className="space-y-4 flex-1">
          {anomalies.slice(0, 5).map((a) => (
            <div
              key={a.id}
              className={
                a.severity === "high"
                  ? "p-3 rounded-lg bg-error-container/20 border border-error-container/30 flex items-start gap-3"
                  : "p-3 rounded-lg bg-tertiary-container/10 border border-tertiary-container/30 flex items-start gap-3"
              }
            >
              <div
                className={
                  a.severity === "high"
                    ? "bg-error-container text-on-error-container p-1 rounded"
                    : "bg-tertiary-container text-on-tertiary-container p-1 rounded"
                }
              >
                <span className="material-symbols-outlined text-[16px]">
                  {a.type === "refund" ? "emergency_home" : "sell"}
                </span>
              </div>
              <div>
                <p
                  className={
                    a.severity === "high"
                      ? "text-sm font-bold text-on-error-container"
                      : "text-sm font-bold text-on-tertiary-container"
                  }
                >
                  {a.type === "refund" ? "Refund Spike detected" : "Unusual Discount Usage"}
                </p>
                <p className="text-[11px] text-on-surface-variant">
                  {a.user} &middot; Rate {(a.rate * 100).toFixed(1)}% (avg {(a.avgRate * 100).toFixed(1)}%)
                </p>
                <button className="text-[11px] text-primary font-bold mt-1 inline-block uppercase tracking-wider">
                  {a.type === "refund" ? "Investigate Reports" : "Review Transactions"}
                </button>
              </div>
            </div>
          ))}
        </div>
      )}

      <button className="mt-6 w-full py-2 border border-outline-variant rounded-lg text-xs font-bold hover:bg-surface-container-high transition-colors">
        Clear Alerts
      </button>
    </div>
  );
}
</file>

